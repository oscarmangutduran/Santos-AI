# ==========================================
# Configuración General de la Aplicación
# ==========================================
APP_NAME="Santos-AI WhatsApp Agent"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# ==========================================
# WhatsApp Business Cloud API (Meta)
# ==========================================
# Token personalizado que defines tú y configuras en el panel de Meta Developers
META_VERIFY_TOKEN="santos_ai_verify_token_secreto_2026"
# Token de acceso permanente (System User Token) o temporal de Meta Graph API
META_ACCESS_TOKEN="EAAGm0PX4ZCpsBA..."
# Identificador del número de teléfono (Phone Number ID en el panel de WhatsApp API)
WHATSAPP_PHONE_NUMBER_ID="102938475610293"
# Secreto de la aplicación de Meta (opcional, recomendado para verificar firma X-Hub-Signature-256)
META_APP_SECRET=""
# Versión de la Graph API de Meta
META_API_VERSION="v21.0"

# ==========================================
# OpenAI / LLM Configuración
# ==========================================
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=500
OPENAI_TIMEOUT_SECONDS=25.0

# ==========================================
# Base de Datos y Memoria Conversacional
# ==========================================
# Por defecto SQLite asíncrono local. Para PostgreSQL usar: postgresql+asyncpg://user:pass@localhost:5432/santos_ai
DATABASE_URL="sqlite+aiosqlite:///./santos_ai.db"
# Cantidad máxima de mensajes previos a inyectar como contexto al LLM por cliente
MAX_CONVERSATION_HISTORY=12

